    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const conversas = item.json.conversas || [];\n  if (!Array.isArray(conversas)) throw new Error(\"A propriedade 'conversas' não é um array.\");\n  let phone = '';\n  let email = '';\n  let nomewpp = 'sem nome';\n  for (const conversa of conversas) {\n    if (conversa.phone && !phone) phone = conversa.phone;\n    if (conversa.email && !email) email = conversa.email;\n    if (conversa.nomewpp && nomewpp === 'sem nome') nomewpp = conversa.nomewpp;\n  }\n  const textoUnico = conversas.map(conversa => {\n    const cliente = conversa.user_message || \"sem mensagem do usuário\";\n    const agente = conversa.bot_message || \"sem resposta do chatbot\";\n    const dataOriginal = conversa.created_at || \"Data indisponível\";\n    const dataFormatada = dataOriginal !== \"Data indisponível\" ? formatarData(dataOriginal) : dataOriginal;\n    return `em: ${dataFormatada}\\n\\n- agente(chatbot): ${agente}\\n- cliente(${conversa.nomewpp || nomewpp}): ${cliente}\\n`;\n  }).join('\\n\\n');\n  return { json: { texto: textoUnico, phone: phone || $('Set Telefone').first().json.Telefone, email: email, nomewpp: nomewpp, conversas_count: conversas.length, has_phone: !!phone, has_email: !!email, first_user_message: conversas[0]?.user_message || 'Nenhuma', first_bot_message: conversas[0]?.bot_message || 'Nenhuma' }, pairedItem: item };\n});\nfunction formatarData(dataString) {\n  try {\n    const data = new Date(dataString);\n    if (isNaN(data.getTime())) return \"Data inválida\";\n    const dia = String(data.getDate()).padStart(2, '0');\n    const mes = String(data.getMonth() + 1).padStart(2, '0');\n    const ano = data.getFullYear();\n    const horas = String(data.getHours()).padStart(2, '0');\n    const minutos = String(data.getMinutes()).padStart(2, '0');\n    return `${dia}/${mes}/${ano} ${horas}:${minutos}`;\n  } catch (error) { return \"Data inválida\"; }\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5696,
        3104
      ],
      "id": "39016cbc-fea7-4c80-a387-e46dff017561",
