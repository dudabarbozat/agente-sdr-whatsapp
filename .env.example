# Variáveis lidas pelos workflows via $env (instância n8n)
# Requer N8N_BLOCK_ENV_ACCESS_IN_NODE=false na instância.

# Números no formato que o provedor de WhatsApp entrega no webhook
WHATSAPP_NUMERO_EMPRESA=
WHATSAPP_NUMERO_ADMIN=
WHATSAPP_NUMERO_TIME=

# Prefixo que direciona uma mensagem para o agente de treinamento da base
PREFIXO_TREINAMENTO=

# Identificadores do provedor WTS Chat
WTS_BOT_ID=
WTS_CANAL_ID=
WTS_DEPARTAMENTO_ID=
WTS_USUARIO_ID=
WTS_DEPARTAMENTO_HUMANO_ID=
WTS_ATENDENTE_HUMANO_ID=

# Base de conhecimento
GOOGLE_DRIVE_PASTA_BASE_ID=
GOOGLE_SHEETS_TREINAMENTO_ID=

# CRM (endpoint que recebe o lead em POST JSON)
CRM_LEADS_URL=

# Usadas apenas pela revisão diária (configurar como secrets no GitHub)
ANTHROPIC_API_KEY=
N8N_API_URL=
N8N_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
